{
  "name": "Sage Custom",
  "colors": {
    "editor.background": "#240000",
    "editor.foreground": "#ffc7c7",
    "editorLineNumber.foreground": "#ff2e2e",
    "editorLineNumber.activeForeground": "#ad0000",
    "editorCursor.foreground": "#7a0000",
    "editor.selectionBackground": "#7a000055",
    "editor.inactiveSelectionBackground": "#7a000030",
    "editor.findMatchBackground": "#7a000066",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#ffc7c7",
    "activityBar.activeBorder": "#7a0000",
    "activityBar.inactiveForeground": "#ff2e2e",
    "sideBar.background": "#0f0000",
    "sideBar.foreground": "#ffc7c7",
    "sideBarSectionHeader.background": "#2e0000",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#ffc7c7",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#ffc7c7",
    "statusBarItem.hoverBackground": "#2e0000",
    "button.background": "#7a0000",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#ad0000",
    "input.background": "#2e0000",
    "input.foreground": "#ffc7c7",
    "input.border": "#470000",
    "focusBorder": "#7a0000",
    "list.activeSelectionBackground": "#7a000055",
    "list.activeSelectionForeground": "#ffc7c7",
    "list.hoverBackground": "#8a000025",
    "panel.background": "#0f0000",
    "panel.border": "#ffc7c720",
    "terminal.background": "#0a0000",
    "terminal.foreground": "#ffc7c7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ff2e2e"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#7a0000"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#8a0000"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#bd0000"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffc7c7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#ad0000"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ffaeae"
      }
    },
    {
      "scope": [
        "constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#570000"
      }
    }
  ]
}